generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Association {
  id                 String                        @id @default(cuid())
  name               String
  slug               String                        @unique
  sector             String?
  description        String?
  logoUrl            String?
  primaryColor       String?
  appName            String?
  domain             String?                       @unique
  headOfficeAddress  String?
  city               String?
  state              String?
  pincode            String?
  registrationNumber String?
  gstNumber          String?
  website            String?
  contactNumbers     Json?
  helpdeskNumber     String?
  googleMapsLink     String?
  isActive           Boolean                       @default(true)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  members            Member[]
  users              User[]
  regionalAddresses  AssociationRegionalAddress[]
  aboutContent       AssociationAboutContent?
  galleryItems       AssociationGalleryItem[]
  galleryFolders     AssociationGalleryFolder[]
  circularDocuments  AssociationCircularDocument[]
  appAccess         AssociationAppAccess?
  MemberPost         MemberPost[]
  vendors            Vendor[]
  timelinePosts      TimelinePost[]
  appBanners         AppBanner[]
  eventTypes         AssociationEventType[]
  events             AssociationEvent[]
  vendorCategories   VendorCategory[]
  vendorSubCategories VendorSubCategory[]
}

model AssociationAppAccess {
  id                            String      @id @default(cuid())
  associationId                 String      @unique
  approveMembersLogin           Boolean     @default(true)
  disableScreenshots            Boolean     @default(false)
  approveMembership             Boolean     @default(true)
  approveRegistrationRequest    Boolean     @default(true)
  disableAdminFunctionsFromApp  Boolean     @default(false)
  createdAt                     DateTime    @default(now())
  updatedAt                     DateTime    @updatedAt
  association                   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
}

model AssociationRegionalAddress {
  id                 String      @id @default(cuid())
  associationId      String
  label              String?
  officeAddress      String?
  city               String?
  state              String?
  pincode            String?
  registrationNumber String?
  gstNumber          String?
  website            String?
  contactNumbers     Json?
  helpdeskNumber     String?
  googleMapsLink     String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  association        Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([associationId])
}

model AssociationAboutContent {
  id              String      @id @default(cuid())
  associationId   String      @unique
  heroTitle       String?
  heroIntro       String?
  missionTitle    String?
  missionText     String?
  goalsTitle      String?
  goalsText       String?
  journeyTitle    String?
  journeyText     String?
  headOfficeImage String?
  galleryImageOne String?
  galleryImageTwo String?
  stats           Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  association     Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
}

model AssociationGalleryItem {
  id            String      @id @default(cuid())
  associationId String
  imageUrl      String?
  headline      String
  tagline       String?
  description   String?
  displayOrder  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([associationId, displayOrder])
}

model AssociationGalleryFolder {
  id            String                    @id @default(cuid())
  associationId String
  name          String
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  association   Association               @relation(fields: [associationId], references: [id], onDelete: Cascade)
  photos        AssociationGalleryPhoto[]

  @@index([associationId, createdAt])
}

model AssociationGalleryPhoto {
  id        String                   @id @default(cuid())
  folderId  String
  imageUrl  String?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  folder    AssociationGalleryFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId, createdAt])
}

model AssociationCircularDocument {
  id               String      @id @default(cuid())
  associationId    String
  headline         String
  tagline          String?
  summary          String?
  originalFileName String
  storedFileName   String
  storagePath      String
  mimeType         String
  fileSize         Int
  displayOrder     Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  association      Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([associationId, displayOrder])
}

model AssociationEventType {
  id            String      @id @default(cuid())
  associationId String
  name          String
  description   String
  displayOrder  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([associationId, displayOrder])
}

model AssociationEvent {
  id                   String      @id @default(cuid())
  associationId        String
  name                 String
  type                 String
  audience             String?
  entryType            String?
  entryCharges         String?
  participationCharges String?
  date                 DateTime
  venue                String?
  startTime            String?
  endTime              String?
  summary              String?
  bannerUrl            String?
  bannerFileName       String?
  promoVideoUrl        String?
  promoVideoFileName   String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  association          Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([associationId, date])
}

model Member {
  id                   String        @id @default(cuid())
  associationId        String
  firstName            String
  lastName             String
  email                String
  phone                String?
  address              String?
  gst                  String?
  photoUrl             String?
  companyName          String?
  roleTitle            String?
  specialization       String?
  committeePost        String?
  committeeTenureStart DateTime?
  committeeTenureEnd   DateTime?
  memberBio            String?
  membershipDetails    String?
  membershipStartDate  DateTime?
  membershipEndDate    DateTime?
  paymentAmount        String?
  paymentStatus        PaymentStatus @default(PENDING)
  customFieldValues    Json?
  membershipStatus     MemberStatus  @default(ACTIVE)
  joinedAt             DateTime      @default(now())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  association          Association   @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user                 User?
  posts                MemberPost[]
  timelinePosts        TimelinePost[]

  @@unique([associationId, email])
  @@index([associationId])
}

model MemberPost {
  id            String           @id @default(cuid())
  memberId      String
  associationId String
  title         String
  summary       String
  body          String?
  mediaUrl      String?
  mediaType     String?
  postType      String?
  reviewStatus  PostReviewStatus @default(PENDING)
  displayStart  DateTime?
  displayEnd    DateTime?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  association   Association      @relation(fields: [associationId], references: [id], onDelete: Cascade)
  member        Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([associationId, createdAt])
  @@index([memberId, createdAt])
  @@index([reviewStatus])
}

model User {
  id             String         @id @default(cuid())
  associationId  String?
  memberId       String?        @unique
  vendorId       String?
  firstName      String
  lastName       String
  email          String         @unique
  phone          String?
  passwordHash   String
  isAdmin        Boolean        @default(false)
  isSuperAdmin   Boolean        @default(false)
  isMember       Boolean        @default(false)
  isVendor       Boolean        @default(false)
  approvalStatus ApprovalStatus @default(PENDING)
  isActive       Boolean        @default(true)
  approvedAt     DateTime?
  rejectedAt     DateTime?
  approvalNotes  String?
  approvedById   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  association    Association?   @relation(fields: [associationId], references: [id], onDelete: SetNull)
  member         Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  vendor         Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  approvedBy     User?          @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers  User[]         @relation("UserApprovals")
  sessions       UserSession[]

  @@index([associationId])
  @@index([approvalStatus])
  @@index([isAdmin, isSuperAdmin, isMember, isVendor])
  @@index([vendorId])
}

model UserSession {
  id               String   @id @default(cuid())
  userId           String
  tokenHash        String   @unique
  refreshTokenHash String   @unique
  deviceInfo       String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  expiresAt        DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt, revokedAt])
  @@index([refreshExpiresAt, revokedAt])
}

model Vendor {
  id                String        @id @default(cuid())
  associationId     String
  name              String
  companyName       String
  contactPerson     String?
  email             String
  phone             String?
  whatsapp          String?
  address           String?
  city              String?
  vendorType        String?
  category          String?
  facebookUrl       String?
  instagramUrl      String?
  youtubeUrl        String?
  linkedinUrl       String?
  xUrl              String?
  onboardingStartAt DateTime?
  onboardingEndAt   DateTime?
  membershipPlan    String?
  paymentStatus     PaymentStatus @default(PENDING)
  paymentAmount     String?
  paymentDueDate    DateTime?
  badge             String?
  notes             String?
  status            VendorStatus  @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  association       Association   @relation(fields: [associationId], references: [id], onDelete: Cascade)
  users             User[]
  timelinePosts     TimelinePost[]
  appBanners        AppBanner[]

  @@unique([associationId, email])
  @@index([associationId, createdAt])
  @@index([associationId, status])
}

model VendorCategory {
  id               String              @id @default(cuid())
  associationId    String
  name             String
  displayOrder     Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  association      Association         @relation(fields: [associationId], references: [id], onDelete: Cascade)
  subCategories    VendorSubCategory[]

  @@unique([associationId, name])
  @@index([associationId, displayOrder])
}

model VendorSubCategory {
  id               String         @id @default(cuid())
  associationId    String
  categoryId       String
  name             String
  displayOrder     Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  association      Association    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  category         VendorCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name])
  @@index([associationId, categoryId, displayOrder])
}

model TimelinePost {
  id              String             @id @default(cuid())
  associationId   String
  sourceType      TimelineSourceType
  memberId        String?
  vendorId        String?
  postedBy        String?
  caption         String
  contactNumber   String?
  imageUrl        String?
  imageType       String?
  landingPageUrl  String?
  youtubeUrl      String?
  facebookUrl     String?
  brochureUrl     String?
  brochureMimeType String?
  reviewStatus    PostReviewStatus   @default(PENDING)
  displayStart    DateTime?
  displayEnd      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  association     Association        @relation(fields: [associationId], references: [id], onDelete: Cascade)
  member          Member?            @relation(fields: [memberId], references: [id], onDelete: SetNull)
  vendor          Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([associationId, createdAt])
  @@index([sourceType, createdAt])
  @@index([reviewStatus])
}

model AppBanner {
  id               String           @id @default(cuid())
  associationId    String
  vendorId         String?
  shortText        String
  contactNumber    String?
  mediaUrl         String?
  mediaType        String?
  brochureUrl      String?
  brochureMimeType String?
  socialMediaUrl   String?
  reviewStatus     PostReviewStatus @default(PENDING)
  paymentReceived  Boolean          @default(false)
  paymentMode      String?
  paymentRemarks   String?
  displayStart     DateTime?
  displayEnd       DateTime?
  displayIndex     Int?
  approvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  association      Association      @relation(fields: [associationId], references: [id], onDelete: Cascade)
  vendor           Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([associationId, createdAt])
  @@index([reviewStatus])
  @@index([displayIndex])
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

enum PostReviewStatus {
  PENDING
  ON_HOLD
  APPROVED
  REJECTED
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LAPSED
}

enum TimelineSourceType {
  ASSOCIATION
  MEMBER
  VENDOR
}
